model Admin {
  name     String
  email    String @unique
  password String
}

model Client {
  client_number Int    @id @default(autoincrement())
  name          String
  email         String @unique
  phone         Int
  password      String
  adress        String
}

model Menu {
  plate_id    Int    @id @default(autoincrement())
  name        String
  description String
  price       Float
  category    String
}

model Pedidos {
  order_id            Int    @id @default(autoincrement())
  order_client        Int
  status              String
  plates              String
  amount              Float
  discount_percentage Float
  deliver_adress      String
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Table {
  table_number Int    @id
  status       String
}
