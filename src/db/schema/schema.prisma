generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Table {
  table_number Int @id @default(autoincrement())
  status Boolean

  reservation Reservation[]
}

model Order {
  order_id Int @id @default(autoincrement())
  order_client Int
  status String
  plates String
  deliver_address String
  discount Float?
  total Float?

  plates_order OrderPlate[]
}

model Plate {
  plate_id Int @id @default(autoincrement())
  name String
  description String
  price Float
  category String

  order_plates OrderPlate[]
}

model OrderPlate {
  id Int @id @default(autoincrement())
  order_id Int  
  plate_id Int

  plate Plate @relation(fields: [plate_id], references: [plate_id])  
  order Order @relation(fields: [order_id], references: [order_id])
}


model Client {
  client_id Int @id @default(autoincrement())
  name String
  email String @unique
  phone Int
  password String
  address String

  reservation Reservation[]
}

model Admin {
  name String
  email String @unique
  password String
}

model Reservation {
  reservation_id Int @id @default(autoincrement())
  datetime DateTime @default(now())
  table_id Int
  client_id Int

  table Table @relation(fields: [table_id], references: [table_number])
  client Client @relation(fields: [client_id], references: [client_id])
}